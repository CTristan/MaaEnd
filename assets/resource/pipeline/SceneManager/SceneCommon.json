        "post_delay": 0
    },
    "__ScenePrivateCloseADBExit": {
        "desc": "关闭ADB控制器的退出游戏界面 — clicks the Cancel button via target_offset on the matched 'Exit the game?' text. NOTE: ClickKey key=4 (Android BACK) does NOT propagate through MuMu Player Pro's ADB controller into the Unity game (verified 2026-04-20 — keyevent fires successfully but the dialog does not dismiss). target_offset values calibrated against captured frame: text box ~[560,340,171,33] → Cancel button center ~(538,491).",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    329,
                    243,
                    710,
                    220
                ],
                "expected": [
                    // @i18n-skip
                    "是否退出游戏",
                    "是否退出遊戲",
                    "(?i)Exit\\s*the\\s*game",
                    "ゲームを終了しますか"
                ]
            }
        },
        "pre_wait_freezes": 200,
        "pre_delay": 0,
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [
                    -107,
                    134,
                    0,
                    0
                ]
            }
        },
        "post_wait_freezes": 200,
        "post_delay": 0
    },
    "__ScenePrivateCloseMainMenu": {
        "desc": "关闭ADB控制器的主菜单界面 (game main menu with OMV DIJIANG ship + AIC Plan/Report tabs). DISABLED for now: action would be ClickKey BACK, which does not propagate through MuMu's ADB to the game (see __ScenePrivateCloseADBExit for the same issue). Recognition is left in place so future work can swap in a click-on-clickable-element action; for now this node is not wired into SceneAnyEnterWorld.",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    400,
                    300,
                    600,
                    250
                ],
                "expected": [
                    "(?i)OMV\\s*DIJIANG",
                    "(?i)AIC\\s*Plan",
                    "(?i)AIC\\s*Report"
                ]
            }
        },
        "pre_wait_freezes": 200,
        "pre_delay": 0,
        "action": {
            "type": "DoNothing"
        },
        "post_wait_freezes": 200,
        "post_delay": 0
    },
    "__ScenePrivateCloseDijiangSubMenu": {
        "desc": "帝江号子界面：依次尝试右上角 X 或返回箭头，逐层回到控制中枢",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "__CloseButtonType4",
                    "__DijiangSubViewBackArrow"
                ]
            }
        },
        "pre_wait_freezes": 200,
        "pre_delay": 0,
        "action": { "type": "Click" },
        "post_wait_freezes": {
            "time": 200,
            "target": [0, 0, 100, 100]
        },
        "post_delay": 0
    },
    "__DijiangSubViewBackArrow": {
        "desc": "帝江号深层子界面右上角返回箭头 (reused from ClaimDijiangRewards/back.png)",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [980, 102, 187, 82],
                "template": ["ClaimDijiangRewards/back.png"]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    }
}
