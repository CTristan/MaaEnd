{
    "__ScenePrivateNextTrue": {
        "desc": "识别结果永远为真，用于退出next循环"
    },
    "__ScenePrivateAnyExit": {
        "desc": "退出当前场景，返回上一个场景",
        "pre_delay": 0,
        "action": {
            "type": "ClickKey",
            "param": {
                "key": 27 // ESC
            }
        },
        "post_wait_freezes": {
            "target": [
                0,
                0,
                100,
                100
            ],
            "time": 600
        },
        "post_delay": 0
    },
    "__ScenePrivateEndVisit": {
        "desc": "识别处于好友飞船大世界",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    0,
                    199,
                    126
                ],
                "expected": [
                    "离开",
                    "離開",
                    "(?i)Leave",
                    "退出"
                ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "AutoAltClickAction"
            }
        }
    },
    "__ScenePrivateEndVisitConfirm": {
        "desc": "识别结束拜访的确认弹框",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    -260,
                    -100,
                    260,
                    100
                ],
                "expected": [
                    "结束拜访",
                    "結束拜訪",
                    "(?i)End\\s*Visit",
                    "訪問終了",
                    "방문 종료"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [
            "[JumpBack]SceneDialogConfirm",
            "SceneWaitLoadingExit"
        ]
    },
